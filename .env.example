# ==============================================================================
# OIA – Overthinker Image AI — Environment Configuration Template (v1.0.0)
# Copy this file to .env (or apps/api/.env) and replace placeholder values.
# NEVER commit real secrets, API keys, or production tokens to version control.
# ==============================================================================

# --- Edition & Runtime ---
# LOCAL = Single-user local studio with automatic default workspace
# SAAS  = Multi-tenant SaaS mode requiring session authentication
APP_EDITION=LOCAL
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- Database (SQLite via Prisma) ---
# Relative to apps/api/prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# --- Storage ---
# Local filesystem storage root (default: <repo>/storage)
STORAGE_ROOT=./storage
MAX_LOGO_FILE_SIZE_MB=15

# Optional S3-compatible object storage (Cloud Edition)
# STORAGE_DRIVER=LOCAL
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# --- Hybrid AI Engine ---
# AI_PROVIDER: heuristic | local-ollama | local-openai | cloud-openai | cloud-gemini
AI_PROVIDER=heuristic
AI_MODE=HYBRID

# Local AI Providers
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
LOCAL_OPENAI_BASE_URL=http://localhost:1234/v1
LOCAL_OPENAI_MODEL=local-model
COMFYUI_BASE_URL=http://localhost:8188
COMFYUI_DEFAULT_MODEL=sd_xl_base_1.0.safetensors

# Cloud AI Providers (leave empty if using Local-Only mode)
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Security & Encryption ---
# Replace with a strong 32+ character random secret in production
MARKETING_TOKEN_SECRET=replace-with-strong-random-32-char-secret
SESSION_SECRET=replace-with-strong-session-secret
