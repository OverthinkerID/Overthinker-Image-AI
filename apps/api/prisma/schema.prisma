model ContentScheduleItem {
  id          String   @id @default(cuid())
  workspaceId String
  calendarId  String
  contentId   String?
  title       String
  platform    String
  scheduledAt DateTime
  timezone    String   @default("Asia/Jakarta")
  status      String   @default("SCHEDULED") // SCHEDULED | QUEUED | PUBLISHED | FAILED | CANCELLED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  calendar    ContentCalendar   @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  content     MarketingContent? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@index([workspaceId, calendarId, scheduledAt])
  @@map("content_schedule_items")
}

model PublishingAccount {
  id                String   @id @default(cuid())
  workspaceId       String
  projectId         String
  connectionId      String?
  platform          String
  accountName       String
  externalAccountId String?
  status            String   @default("NOT_CONNECTED") // NOT_CONNECTED | CONNECTED | REVOKED | ERROR
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connection        PlatformConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  jobs              PublishingJob[]

  @@index([workspaceId, projectId])
  @@map("publishing_accounts")
}

model PublishingJob {
  id                String    @id @default(cuid())
  workspaceId       String
  projectId         String
  contentId         String?
  accountId         String?
  platform          String
  idempotencyKey    String    @unique
  status            String    @default("PENDING_APPROVAL") // PENDING_APPROVAL | PREFLIGHT_FAILED | QUEUED | DISPATCHED | CONFIRMED_PUBLISHED | FAILED | CANCELLED
  preflightJson     String    @default("{}")
  externalPostId    String?
  platformConfirmed Boolean   @default(false)
  errorMessage      String?
  scheduledFor      DateTime?
  dispatchedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content           MarketingContent?  @relation(fields: [contentId], references: [id], onDelete: SetNull)
  account           PublishingAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([workspaceId, projectId, status])
  @@map("publishing_jobs")
}

model AdCampaign {
  id                  String   @id @default(cuid())
  workspaceId         String
  projectId           String
  marketingCampaignId String?
  platform            String   // META_ADS | GOOGLE_ADS | TIKTOK_ADS | YOUTUBE_ADS | LINKEDIN_ADS
  name                String
  objective           String   // AWARENESS | TRAFFIC | LEADS | CONVERSIONS
  dailyBudgetCents    Int      @default(0)
  durationDays        Int      @default(14)
  currency            String   @default("USD")
  targetingJson       String   @default("{}")
  budgetEstimateJson  String   @default("{}") // Explicit assumptions, never promises ROI
  status              String   @default("DRAFT")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  project             Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  marketingCampaign   MarketingCampaign? @relation(fields: [marketingCampaignId], references: [id], onDelete: SetNull)
  creatives           AdCreative[]

  @@index([workspaceId, projectId])
  @@map("ad_campaigns")
}

model AdCreative {
  id           String   @id @default(cuid())
  workspaceId  String
  adCampaignId String
  format       String   // SINGLE_IMAGE | CAROUSEL | VIDEO | SEARCH_TEXT
  headline     String
  primaryText  String
  description  String?
  cta          String
  variantLabel String   @default("A")
  assetPath    String?
  createdAt    DateTime @default(now())

  adCampaign   AdCampaign @relation(fields: [adCampaignId], references: [id], onDelete: Cascade)

  @@index([workspaceId, adCampaignId])
  @@map("ad_creatives")
}

model LandingPage {
  id           String   @id @default(cuid())
  workspaceId  String
  projectId    String
  title        String
  slug         String
  sectionsJson String   @default("[]")
  htmlContent  String
  cssContent   String
  jsContent    String   @default("")
  isSanitized  Boolean  @default(true)
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, projectId])
  @@map("landing_pages")
}

model MarketingAnalytics {
  id           String   @id @default(cuid())
  workspaceId  String
  projectId    String
  platform     String
  periodDate   DateTime
  impressions  Int      @default(0)
  reach        Int      @default(0)
  clicks       Int      @default(0)
  engagements  Int      @default(0)
  conversions  Int      @default(0)
  spendCents   Int      @default(0)
  revenueCents Int      @default(0)
  ctr          Float    @default(0)
  cpcCents     Float    @default(0)
  dataSource   String   @default("MANUAL") // MANUAL | CSV_IMPORT | PLATFORM_SYNC
  createdAt    DateTime @default(now())

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, projectId, periodDate])
  @@map("marketing_analytics")
}

model MarketingReport {
  id                 String   @id @default(cuid())
  workspaceId        String
  projectId          String
  title              String
  periodLabel        String
  actualSummaryJson  String   @default("{}")
  calculatedKpisJson String   @default("{}")
  aiInsightsJson     String   @default("[]")
  provider           String   @default("heuristic")
  model              String?
  createdAt          DateTime @default(now())

  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, projectId])
  @@map("marketing_reports")
}

model MarketingRecommendation {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String
  category    String   // CONTENT | TIMING | AD_BUDGET | CHANNEL_MIX | COPY
  title       String
  rationale   String
  priority    String   @default("MEDIUM")
  status      String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, projectId])
  @@map("marketing_recommendations")
}

model PlatformConnection {
  id                 String    @id @default(cuid())
  workspaceId        String
  projectId          String
  platform           String
  displayName        String
  status             String    @default("NOT_CONNECTED") // NOT_CONNECTED | PENDING_OAUTH | CONNECTED | TOKEN_EXPIRED | REVOKED | NOT_SUPPORTED
  oauthState         String?
  encryptedToken     String?
  encryptedRefresh   String?
  tokenIv            String?
  tokenAuthTag       String?
  capabilitiesJson   String    @default("{}")
  lastSyncedAt       DateTime?
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project            Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  permissions        PlatformPermission[]
  publishingAccounts PublishingAccount[]

  @@index([workspaceId, projectId, platform])
  @@map("platform_connections")
}

model PlatformPermission {
  id           String   @id @default(cuid())
  connectionId String
  scope        String
  granted      Boolean  @default(false)
  createdAt    DateTime @default(now())

  connection   PlatformConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@map("platform_permissions")
}

model CampaignApproval {
  id          String    @id @default(cuid())
  workspaceId String
  campaignId  String
  stage       Int
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED | REVISION_REQUESTED
  reviewerId  String?
  comment     String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  campaign    MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([workspaceId, campaignId])
  @@map("campaign_approvals")
}

// ==========================================
// PHASE 12: AI Brand Video & Motion Studio
// ==========================================

model VideoProject {
  id          String    @id @default(cuid())
  workspaceId String
  projectId   String
  userId      String?
  title       String
  templateKey String?   // 12 brand video templates
  mode        String    @default("AUTOMATIC") // AUTOMATIC | SEMI_AUTOMATIC | MANUAL
  aspectRatio String    @default("16:9") // 16:9 | 9:16 | 1:1 | 4:5
  durationSec Int       @default(15)
  status      String    @default("DRAFT") // DRAFT | IN_PROGRESS | WAITING_APPROVAL | RENDERED | APPROVED
  provider    String    @default("local-ffmpeg")
  model       String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scripts     VideoScript[]
  storyboards VideoStoryboard[]
  jobs        VideoGenerationJob[]
  timelines   VideoTimeline[]
  renderJobs  VideoRenderJob[]
  versions    VideoVersion[]
  qcReports   VideoQualityReport[]

  @@index([workspaceId, projectId, deletedAt])
  @@map("video_projects")
}

model VideoScript {
  id             String   @id @default(cuid())
  workspaceId    String
  projectId      String
  videoProjectId String
  title          String
  language       String   @default("id-ID")
  narrationText  String
  hook           String?
  cta            String?
  durationEstSec Int      @default(15)
  isApproved     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  videoProject   VideoProject @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, projectId])
  @@map("video_scripts")
}

model VideoStoryboard {
  id             String   @id @default(cuid())
  workspaceId    String
  projectId      String
  videoProjectId String
  title          String
  isApproved     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  videoProject   VideoProject @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)
  scenes         VideoScene[]

  @@index([workspaceId, projectId])
  @@map("video_storyboards")
}

model VideoScene {
  id            String   @id @default(cuid())
  storyboardId  String
  sceneOrder    Int
  title         String
  visualPrompt  String
  narrationLine String?
  durationSec   Float    @default(3.0)
  motionStyle   String   @default("SMOOTH_PAN")
  createdAt     DateTime @default(now())

  storyboard    VideoStoryboard @relation(fields: [storyboardId], references: [id], onDelete: Cascade)
  shots         VideoShot[]

  @@index([storyboardId, sceneOrder])
  @@map("video_scenes")
}

model VideoShot {
  id          String   @id @default(cuid())
  sceneId     String
  shotOrder   Int
  cameraMove  String   @default("STATIC")
  framing     String   @default("MEDIUM")
  durationSec Float    @default(3.0)
  notes       String?
  createdAt   DateTime @default(now())

  scene       VideoScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([sceneId, shotOrder])
  @@map("video_shots")
}

model VideoGenerationJob {
  id             String    @id @default(cuid())
  workspaceId    String
  projectId      String
  videoProjectId String?
  jobType        String    // TEXT_TO_VIDEO | IMAGE_TO_VIDEO | REF_TO_VIDEO | LOGO_ANIMATION
  provider       String    @default("local-ffmpeg")
  model          String?
  prompt         String
  paramsJson     String    @default("{}")
  status         String    @default("QUEUED") // QUEUED | RUNNING | COMPLETED | FAILED | CANCELLED
  progress       Int       @default(0)
  outputAssetId  String?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  videoProject   VideoProject? @relation(fields: [videoProjectId], references: [id], onDelete: SetNull)

  @@index([workspaceId, projectId, status])
  @@map("video_generation_jobs")
}

model VideoAsset {
  id              String   @id @default(cuid())
  workspaceId     String
  projectId       String
  sourceLogoId    String?
  assetType       String   // GENERATED_CLIP | LOGO_ANIMATION | B_ROLL | RENDERED_VIDEO
  title           String
  storagePath     String
  mimeType        String   @default("video/mp4")
  width           Int      @default(1920)
  height          Int      @default(1080)
  durationSec     Float    @default(5.0)
  fps             Int      @default(30)
  hasAlpha        Boolean  @default(false)
  preservesLogo   Boolean  @default(true)
  provider        String   @default("local-ffmpeg")
  createdAt       DateTime @default(now())

  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clips           VideoClip[]

  @@index([workspaceId, projectId])
  @@map("video_assets")
}

model VideoTimeline {
  id             String   @id @default(cuid())
  workspaceId    String
  projectId      String
  videoProjectId String
  title          String
  fps            Int      @default(30)
  width          Int      @default(1920)
  height         Int      @default(1080)
  durationSec    Float    @default(15.0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  videoProject   VideoProject      @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)
  tracks         VideoTrack[]
  transitions    VideoTransition[]
  overlays       VideoTextOverlay[]
  subtitles      VideoSubtitle[]

  @@index([workspaceId, projectId])
  @@map("video_timelines")
}

model VideoTrack {
  id         String   @id @default(cuid())
  timelineId String
  trackType  String   // VIDEO | AUDIO | TEXT | SUBTITLE | LOGO
  name       String
  orderIndex Int      @default(0)
  isMuted    Boolean  @default(false)
  isLocked   Boolean  @default(false)
  createdAt  DateTime @default(now())

  timeline   VideoTimeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  clips      VideoClip[]

  @@index([timelineId, orderIndex])
  @@map("video_tracks")
}

model VideoClip {
  id          String   @id @default(cuid())
  trackId     String
  assetId     String?
  audioId     String?
  label       String
  startSec    Float    @default(0)
  durationSec Float    @default(5)
  trimInSec   Float    @default(0)
  trimOutSec  Float?   
  volume      Float    @default(1.0)
  transformJson String @default("{}")
  createdAt   DateTime @default(now())

  track       VideoTrack       @relation(fields: [trackId], references: [id], onDelete: Cascade)
  asset       VideoAsset?      @relation(fields: [assetId], references: [id], onDelete: SetNull)
  audio       VideoAudioAsset? @relation(fields: [audioId], references: [id], onDelete: SetNull)

  @@index([trackId, startSec])
  @@map("video_clips")
}

model VideoTransition {
  id             String   @id @default(cuid())
  timelineId     String
  transitionType String   // FADE | DISSOLVE | WIPE_LEFT | ZOOM_IN
  atSec          Float
  durationSec    Float    @default(0.5)
  createdAt      DateTime @default(now())

  timeline       VideoTimeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)

  @@index([timelineId])
  @@map("video_transitions")
}

model VideoTextOverlay {
  id          String   @id @default(cuid())
  timelineId  String
  text        String
  fontFamily  String   @default("Inter")
  fontSize    Int      @default(48)
  colorHex    String   @default("#FFFFFF")
  startSec    Float    @default(0)
  durationSec Float    @default(3)
  positionJson String  @default("{\"x\":0.5,\"y\":0.8}")
  createdAt   DateTime @default(now())

  timeline    VideoTimeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)

  @@index([timelineId])
  @@map("video_text_overlays")
}

model VideoAudioAsset {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String
  voiceProfileId String?
  audioType   String   // VOICEOVER | BGM | SFX
  title       String
  language    String   @default("id-ID")
  storagePath String
  mimeType    String   @default("audio/wav")
  durationSec Float    @default(5.0)
  provider    String   @default("local-tts")
  createdAt   DateTime @default(now())

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  voiceProfile VoiceProfile? @relation(fields: [voiceProfileId], references: [id], onDelete: SetNull)
  clips        VideoClip[]

  @@index([workspaceId, projectId])
  @@map("video_audio_assets")
}

model VoiceProfile {
  id             String   @id @default(cuid())
  workspaceId    String
  projectId      String
  name           String
  language       String   @default("id-ID")
  gender         String?  
  consentGranted Boolean  @default(false)
  consentNote    String?
  provider       String   @default("local-tts")
  createdAt      DateTime @default(now())

  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  audioAssets    VideoAudioAsset[]

  @@index([workspaceId, projectId])
  @@map("voice_profiles")
}

model VideoSubtitle {
  id         String   @id @default(cuid())
  timelineId String
  language   String   @default("id-ID")
  format     String   @default("SRT") // SRT | VTT
  content    String
  createdAt  DateTime @default(now())

  timeline   VideoTimeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)

  @@index([timelineId])
  @@map("video_subtitles")
}

model VideoRenderJob {
  id              String    @id @default(cuid())
  workspaceId     String
  projectId       String
  videoProjectId  String
  profileId       String?
  format          String    @default("MP4") // MP4 | WEBM
  aspectRatio     String    @default("16:9")
  width           Int       @default(1920)
  height          Int       @default(1080)
  supportsAlpha   Boolean   @default(false) // Never claim alpha on standard MP4
  status          String    @default("QUEUED") // QUEUED | RENDERING | COMPLETED | FAILED
  progress        Int       @default(0)
  outputPath      String?
  editableBundlePath String?
  errorMessage    String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  videoProject    VideoProject        @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)
  profile         VideoExportProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([workspaceId, projectId, status])
  @@map("video_render_jobs")
}

model VideoVersion {
  id             String   @id @default(cuid())
  videoProjectId String
  version        Int
  snapshotJson   String
  changeNote     String?
  createdAt      DateTime @default(now())

  videoProject   VideoProject @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)

  @@unique([videoProjectId, version])
  @@map("video_versions")
}

model VideoExportProfile {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String
  name        String
  aspectRatio String   // 16:9 | 9:16 | 1:1 | 4:5
  width       Int
  height      Int
  fps         Int      @default(30)
  format      String   @default("MP4")
  createdAt   DateTime @default(now())

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  renderJobs  VideoRenderJob[]

  @@index([workspaceId, projectId])
  @@map("video_export_profiles")
}

model VideoQualityReport {
  id             String   @id @default(cuid())
  workspaceId    String
  projectId      String
  videoProjectId String
  overallScore   Int
  passed         Boolean
  checksJson     String   @default("[]")
  disclaimer     String   @default("Automated video quality checks verify technical brand/format rules and do not guarantee campaign performance.")
  createdAt      DateTime @default(now())

  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  videoProject   VideoProject @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, projectId])
  @@map("video_quality_reports")
}
