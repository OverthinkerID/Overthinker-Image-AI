// Prisma Schema for Overthinker Image AI (Phases 1 - 6)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(cuid())
  workspaceId String?
  name        String
  slug        String   @unique
  description String?
  industry    String?
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace          Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  logos              LogoAsset[]
  analyses           BrandAnalysis[]
  brandDnas          BrandDna[]
  concepts           BrandConcept[]
  aiJobs             AiJob[]
  brandAssets        BrandAsset[]
  logoVariations     LogoVariation[]
  colorSystems       ColorSystem[]
  typographySystems  TypographySystem[]
  graphicElements    GraphicElement[]
  designTemplates    DesignTemplate[]
  designDocuments    DesignDocument[]
  assetExports       AssetExport[]
  mockupTemplates    MockupTemplate[]
  mockupDocuments    MockupDocument[]
  mockupRenderJobs   MockupRenderJob[]
  brandGuidelines    BrandGuideline[]
  brandPresentations BrandPresentation[]
  automationWorkflows AutomationWorkflow[]
  batchJobs          BatchGenerationJob[]
  qualityReports     QualityReport[]
  consistencyReports ConsistencyReport[]
  assetApprovals     AssetApproval[]
  exportPackages     ExportPackage[]
  clientProjects     ClientProject[]
  clientPortalAccess ClientPortalAccess[]
  comments           ProjectComment[]
  creativeSessions   CreativeSession[]
  creativeAssessments CreativeAssessment[]
  designCriticReports DesignCriticReport[]
  brandConsistencyReports BrandConsistencyReport[]
  creativeRecommendations CreativeRecommendation[]
  creativeBriefs     CreativeBrief[]
  brandComparisons   BrandComparison[]
  assessmentHistory  AssessmentHistory[]
  intelligenceReports BrandIntelligenceReport[]
  imageEditingProjects ImageEditingProject[]
  imageEditingWorkflows ImageEditingWorkflow[]
  marketResearchProjects MarketResearchProject[]
  competitors            Competitor[]
  audienceSegments       AudienceSegment[]
  customerPersonas       CustomerPersona[]
  customerJourneys       CustomerJourney[]
  brandPositionings      BrandPositioning[]
  namingCandidates       BrandNamingCandidate[]
  taglineCandidates      BrandTaglineCandidate[]
  strategyReports        BrandStrategyReport[]
  strategyRecommendations StrategyRecommendation[]
  marketingProjects      MarketingProject[]
  marketingStrategies    MarketingStrategy[]
  marketingCampaigns     MarketingCampaign[]
  contentPillars         ContentPillar[]
  contentIdeas           ContentIdea[]
  marketingContents      MarketingContent[]
  contentCalendars       ContentCalendar[]
  publishingAccounts     PublishingAccount[]
  publishingJobs         PublishingJob[]
  adCampaigns            AdCampaign[]
  landingPages           LandingPage[]
  marketingAnalytics     MarketingAnalytics[]
  marketingReports       MarketingReport[]
  marketingRecommendations MarketingRecommendation[]
  platformConnections    PlatformConnection[]
  videoProjects          VideoProject[]
  videoScripts           VideoScript[]
  videoStoryboards       VideoStoryboard[]
  videoGenerationJobs    VideoGenerationJob[]
  videoAssets            VideoAsset[]
  videoTimelines         VideoTimeline[]
  videoAudioAssets       VideoAudioAsset[]
  voiceProfiles          VoiceProfile[]
  videoRenderJobs        VideoRenderJob[]
  videoExportProfiles    VideoExportProfile[]
  videoQualityReports    VideoQualityReport[]

  @@index([workspaceId])
  @@index([status])
  @@index([createdAt])
}

model LogoAsset {
  id               String   @id @default(cuid())
  projectId        String
  originalFilename String
  storedFilename   String
  storagePath      String   @unique
  mimeType         String
  fileSize         Int
  sha256           String
  width            Int?
  height           Int?
  isOriginal       Boolean  @default(true)
  isPrimary        Boolean  @default(false)
  createdAt        DateTime @default(now())

  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analyses         BrandAnalysis[]
  logoVariations   LogoVariation[]

  @@index([projectId])
  @@index([sha256])
}

model BrandAnalysis {
  id                 String   @id @default(cuid())
  projectId          String
  logoId             String
  format             String
  width              Int
  height             Int
  aspectRatio        String
  aspectLabel        String
  hasTransparency    Boolean  @default(false)
  transparencyRatio  Float    @default(0)
  backgroundType     String   @default("UNKNOWN")
  backgroundHex      String?
  isMonochrome       Boolean  @default(false)
  colorCount         Int      @default(0)
  shapeStyle         String   @default("geometric")
  visualElementsJson String   @default("[]")
  extractedText      String?
  hasText            Boolean  @default(false)
  ocrConfidence      Float    @default(0)
  rawAnalysisJson    String   @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project            Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  logo               LogoAsset  @relation(fields: [logoId], references: [id], onDelete: Cascade)
  brandDnas          BrandDna[]

  @@index([projectId])
  @@index([logoId])
  @@map("brand_analysis")
}

model BrandDna {
  id                      String    @id @default(cuid())
  projectId               String
  analysisId              String?
  version                 Int       @default(1)
  brandName               String
  industry                String?
  brandDescription        String?
  logoCharacteristicsJson String    @default("{}")
  visualDirection         String?
  designRulesJson         String    @default("[]")
  status                  String    @default("DRAFT")
  isApproved              Boolean   @default(false)
  approvedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analysis          BrandAnalysis?     @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  colors            BrandColor[]
  typography        BrandTypography?
  personality       BrandPersonality?
  concepts          BrandConcept[]
  aiJobs            AiJob[]
  colorSystems      ColorSystem[]
  typographySystems TypographySystem[]

  @@unique([projectId, version])
  @@index([projectId, status])
  @@map("brand_dna")
}

model BrandColor {
  id         String   @id @default(cuid())
  brandDnaId String
  role       String
  name       String?
  hex        String
  rgb        String
  hsl        String
  dominance  Float    @default(0)
  isEdited   Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  brandDna   BrandDna @relation(fields: [brandDnaId], references: [id], onDelete: Cascade)

  @@index([brandDnaId, role])
  @@map("brand_colors")
}

model BrandTypography {
  id                       String   @id @default(cuid())
  brandDnaId               String   @unique
  extractedText            String?
  detectedStyle            String   @default("unknown")
  identificationConfidence Float    @default(0)
  confidenceNote           String
  headingFont              String
  bodyFont                 String
  headingFallback          String
  bodyFallback             String
  isManualOverride         Boolean  @default(false)
  recommendationsJson      String   @default("[]")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  brandDna                 BrandDna @relation(fields: [brandDnaId], references: [id], onDelete: Cascade)

  @@map("brand_typography")
}

model BrandPersonality {
  id                        String   @id @default(cuid())
  brandDnaId                String   @unique
  personalityTraitsJson     String   @default("[]")
  visualStyle               String
  targetAudience            String
  industry                  String
  brandPositioning          String
  brandTone                 String
  designRecommendationsJson String   @default("[]")
  providerType              String   @default("heuristic")
  modelName                 String?
  isEdited                  Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  brandDna                  BrandDna @relation(fields: [brandDnaId], references: [id], onDelete: Cascade)

  @@map("brand_personality")
}

model AiProviderConfig {
  id            String    @id @default(cuid())
  name          String
  mode          String    @default("HYBRID")
  providerType  String    @unique
  baseUrl       String?
  defaultModel  String?
  apiKeyRef     String?
  hasApiKey     Boolean   @default(false)
  settingsJson  String    @default("{}")
  isActive      Boolean   @default(true)
  healthStatus  String    @default("UNKNOWN")
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("ai_provider_configs")
}

model ComfyWorkflowTemplate {
  id                String   @id @default(cuid())
  name              String   @unique
  category          String
  version           String   @default("1.0.0")
  description       String?
  workflowJson      String
  defaultParamsJson String   @default("{}")
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("comfyui_workflows")
}

model BrandConcept {
  id                       String    @id @default(cuid())
  projectId                String
  brandDnaId               String
  categoryKey              String
  conceptName              String
  description              String
  visualDirection          String
  moodboardJson            String    @default("{}")
  colorPaletteJson         String    @default("[]")
  typographyJson           String    @default("{}")
  logoApplicationDirection String
  graphicElementsJson      String    @default("[]")
  mockupPreviewsJson       String    @default("[]")
  promptUsed               String
  isFavorite               Boolean   @default(false)
  isPrimary                Boolean   @default(false)
  isApproved               Boolean   @default(false)
  isLocked                 Boolean   @default(false)
  approvedAt               DateTime?
  currentVersion           Int       @default(1)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brandDna           BrandDna            @relation(fields: [brandDnaId], references: [id], onDelete: Cascade)
  revisions          ConceptRevision[]
  aiJobs             AiJob[]
  brandAssets        BrandAsset[]
  logoVariations     LogoVariation[]
  colorSystems       ColorSystem[]
  typographySystems  TypographySystem[]
  graphicElements    GraphicElement[]
  designDocuments    DesignDocument[]
  mockupDocuments    MockupDocument[]
  brandGuidelines    BrandGuideline[]
  brandPresentations BrandPresentation[]

  @@index([projectId, categoryKey])
  @@index([brandDnaId])
  @@map("brand_concepts")
}

model ConceptRevision {
  id                 String   @id @default(cuid())
  conceptId          String
  version            Int
  conceptName        String
  description        String
  visualDirection    String
  colorPaletteJson   String   @default("[]")
  typographyJson     String   @default("{}")
  mockupPreviewsJson String   @default("[]")
  revisionNote       String?
  promptUsed         String?
  createdAt          DateTime @default(now())

  concept            BrandConcept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([conceptId, version])
  @@map("concept_revisions")
}

model AiJob {
  id              String    @id @default(cuid())
  projectId       String
  brandDnaId      String?
  conceptId       String?
  jobType         String
  status          String    @default("QUEUED")
  progress        Int       @default(0)
  provider        String
  model           String?
  prompt          String
  workflowId      String?
  workflowVersion String?
  parametersJson  String    @default("{}")
  outputRefsJson  String    @default("[]")
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brandDna        BrandDna?     @relation(fields: [brandDnaId], references: [id], onDelete: SetNull)
  concept         BrandConcept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([conceptId])
  @@map("ai_jobs")
}

model BrandAsset {
  id           String   @id @default(cuid())
  projectId    String
  conceptId    String?
  name         String
  category     String
  assetType    String
  storagePath  String
  mimeType     String
  width        Int?
  height       Int?
  version      Int      @default(1)
  aiProvider   String   @default("manual")
  status       String   @default("READY")
  isApproved   Boolean  @default(false)
  isLocked     Boolean  @default(false)
  metadataJson String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  concept         BrandConcept?    @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  mockupDocuments MockupDocument[]

  @@index([projectId, category])
  @@index([conceptId])
  @@map("brand_assets")
}

model LogoVariation {
  id            String   @id @default(cuid())
  projectId     String
  parentLogoId  String?
  conceptId     String?
  variationType String
  name          String
  format        String
  storagePath   String
  svgContent    String?
  width         Int      @default(512)
  height        Int      @default(512)
  version       Int      @default(1)
  isEdited      Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentLogo    LogoAsset?    @relation(fields: [parentLogoId], references: [id], onDelete: SetNull)
  concept       BrandConcept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)

  @@index([projectId, variationType])
  @@map("logo_variations")
}

model ColorSystem {
  id           String   @id @default(cuid())
  projectId    String
  brandDnaId   String?
  conceptId    String?
  name         String   @default("Brand Color System")
  version      Int      @default(1)
  palettesJson String   @default("{}")
  contrastJson String   @default("[]")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brandDna     BrandDna?     @relation(fields: [brandDnaId], references: [id], onDelete: SetNull)
  concept      BrandConcept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)

  @@index([projectId, version])
  @@map("color_systems")
}

model TypographySystem {
  id              String   @id @default(cuid())
  projectId       String
  brandDnaId      String?
  conceptId       String?
  name            String   @default("Brand Typography System")
  version         Int      @default(1)
  rolesJson       String   @default("{}")
  customFontsJson String   @default("[]")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brandDna        BrandDna?     @relation(fields: [brandDnaId], references: [id], onDelete: SetNull)
  concept         BrandConcept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)

  @@index([projectId, version])
  @@map("typography_systems")
}

model GraphicElement {
  id          String   @id @default(cuid())
  projectId   String
  conceptId   String?
  elementType String
  name        String
  format      String   @default("SVG")
  storagePath String
  svgContent  String?
  version     Int      @default(1)
  aiProvider  String   @default("manual")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  concept     BrandConcept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)

  @@index([projectId, elementType])
  @@map("graphic_elements")
}

model DesignTemplate {
  id          String   @id @default(cuid())
  projectId   String?
  category    String
  templateKey String
  name        String
  width       Int
  height      Int
  canvasJson  String
  isCustom    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documents   DesignDocument[]

  @@index([category, templateKey])
  @@map("design_templates")
}

model DesignDocument {
  id              String   @id @default(cuid())
  projectId       String
  conceptId       String?
  templateId      String?
  title           String
  category        String   @default("CUSTOM")
  width           Int      @default(1080)
  height          Int      @default(1080)
  canvasJson      String
  currentVersion  Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  concept         BrandConcept?    @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  template        DesignTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  versions        DesignVersion[]
  mockupDocuments MockupDocument[]

  @@index([projectId])
  @@map("design_documents")
}

model DesignVersion {
  id         String   @id @default(cuid())
  documentId String
  version    Int
  canvasJson String
  changeNote String?
  createdAt  DateTime @default(now())

  document   DesignDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@map("design_versions")
}

model AssetExport {
  id          String   @id @default(cuid())
  projectId   String
  documentId  String?
  format      String
  width       Int?
  height      Int?
  dpi         Int      @default(72)
  transparent Boolean  @default(false)
  storagePath String
  fileSize    Int
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, format])
  @@map("asset_exports")
}

model MockupTemplate {
  id               String   @id @default(cuid())
  projectId        String?
  category         String
  templateKey      String
  name             String
  description      String?
  width            Int      @default(1200)
  height           Int      @default(900)
  placementJson    String   @default("{}")
  capabilitiesJson String   @default("{}")
  isFavorite       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project          Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mockups          MockupDocument[]

  @@index([category, templateKey])
  @@map("mockup_templates")
}

model MockupDocument {
  id               String   @id @default(cuid())
  projectId        String
  templateId       String?
  conceptId        String?
  sourceAssetId    String?
  designDocumentId String?
  title            String
  category         String
  width            Int      @default(1200)
  height           Int      @default(900)
  sceneConfigJson  String   @default("{}")
  renderedPath     String?
  currentVersion   Int      @default(1)
  isFavorite       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template         MockupTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  concept          BrandConcept?     @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  sourceAsset      BrandAsset?       @relation(fields: [sourceAssetId], references: [id], onDelete: SetNull)
  designDocument   DesignDocument?   @relation(fields: [designDocumentId], references: [id], onDelete: SetNull)
  versions         MockupVersion[]
  renderJobs       MockupRenderJob[]

  @@index([projectId, category])
  @@map("mockup_documents")
}

model MockupVersion {
  id              String   @id @default(cuid())
  mockupId        String
  version         Int
  sceneConfigJson String
  renderedPath    String?
  changeNote      String?
  createdAt       DateTime @default(now())

  mockup          MockupDocument @relation(fields: [mockupId], references: [id], onDelete: Cascade)

  @@unique([mockupId, version])
  @@map("mockup_versions")
}

model MockupRenderJob {
  id              String    @id @default(cuid())
  projectId       String
  mockupId        String?
  provider        String
  prompt          String
  sourceAssetRefs String    @default("[]")
  status          String    @default("QUEUED")
  progress        Int       @default(0)
  outputPath      String?
  errorMessage    String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mockup          MockupDocument? @relation(fields: [mockupId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@map("mockup_render_jobs")
}

model BrandGuideline {
  id               String   @id @default(cuid())
  projectId        String
  conceptId        String?
  title            String
  layoutConfigJson String   @default("{}")
  currentVersion   Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project          Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  concept          BrandConcept?      @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  sections         GuidelineSection[]
  versions         GuidelineVersion[]

  @@index([projectId])
  @@map("brand_guidelines")
}

model GuidelineSection {
  id            String   @id @default(cuid())
  guidelineId   String
  sectionKey    String
  title         String
  orderIndex    Int
  content       String
  imageRefsJson String   @default("[]")
  layoutType    String   @default("STANDARD")
  isPlaceholder Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  guideline     BrandGuideline @relation(fields: [guidelineId], references: [id], onDelete: Cascade)

  @@index([guidelineId, orderIndex])
  @@map("guideline_sections")
}

model GuidelineVersion {
  id           String   @id @default(cuid())
  guidelineId  String
  version      Int
  snapshotJson String
  changeNote   String?
  createdAt    DateTime @default(now())

  guideline    BrandGuideline @relation(fields: [guidelineId], references: [id], onDelete: Cascade)

  @@unique([guidelineId, version])
  @@map("guideline_versions")
}

model BrandPresentation {
  id             String   @id @default(cuid())
  projectId      String
  conceptId      String?
  title          String
  aspectRatio    String   @default("16:9")
  currentVersion Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project        Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  concept        BrandConcept?         @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  slides         PresentationSlide[]
  versions       PresentationVersion[]

  @@index([projectId])
  @@map("brand_presentations")
}

model PresentationSlide {
  id             String   @id @default(cuid())
  presentationId String
  slideType      String
  title          String
  subtitle       String?
  body           String
  layout         String   @default("SPLIT")
  imageRefsJson  String   @default("[]")
  orderIndex     Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  presentation   BrandPresentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)

  @@index([presentationId, orderIndex])
  @@map("presentation_slides")
}

model PresentationVersion {
  id             String   @id @default(cuid())
  presentationId String
  version        Int
  snapshotJson   String
  changeNote     String?
  createdAt      DateTime @default(now())

  presentation   BrandPresentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)

  @@unique([presentationId, version])
  @@map("presentation_versions")
}

// ==========================================
// PHASE 6: Automation, Batch, QC & Commercial Export
// ==========================================

model AutomationWorkflow {
  id             String    @id @default(cuid())
  projectId      String
  name           String
  mode           String    @default("AUTOMATIC") // AUTOMATIC | SEMI_AUTOMATIC | MANUAL
  status         String    @default("QUEUED") // QUEUED | RUNNING | WAITING_APPROVAL | PAUSED | COMPLETED | FAILED | CANCELLED
  configJson     String    @default("{}")
  currentStepIdx Int       @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  steps          WorkflowStep[]
  executions     WorkflowExecution[]
  approvals      WorkflowApproval[]

  @@index([projectId, status])
  @@map("automation_workflows")
}

model WorkflowStep {
  id             String    @id @default(cuid())
  workflowId     String
  stepOrder      Int
  stepKey        String
  name           String
  isOptional     Boolean   @default(false)
  requiresApproval Boolean @default(false)
  idempotencyKey String    @unique
  status         String    @default("QUEUED") // QUEUED | RUNNING | WAITING_APPROVAL | COMPLETED | FAILED | SKIPPED | CANCELLED
  outputJson     String    @default("{}")
  errorMessage   String?
  attempts       Int       @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workflow       AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, stepOrder])
  @@map("workflow_steps")
}

