  updatedAt         DateTime @updatedAt

  editingProject    ImageEditingProject @relation(fields: [editingProjectId], references: [id], onDelete: Cascade)

  @@index([editingProjectId])
  @@map("protected_regions")
}

model ImageEditingJob {
  id               String    @id @default(cuid())
  workspaceId      String
  projectId        String
  editingProjectId String
